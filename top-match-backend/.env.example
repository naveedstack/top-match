PROJECT_NAME="Top Match Backend"
ENVIRONMENT=local
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]
PUBLIC_APP_URL=http://localhost:3000

DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/top_match?ssl=require
GEMINI_API_KEY=your-gemini-api-key

JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

GEMINI_MODEL=gemini-3.8-flash
LLM_TIMEOUT_SECONDS=60
LLM_MAX_ATTEMPTS=3
LLM_MAX_CONCURRENCY=2
STUCK_APPLICATION_MINUTES=5
PIPELINE_ENABLED=true
RESUME_TOKEN_MINUTES=15
RETENTION_DAYS=30
GEMINI_DATA_USE_ACKNOWLEDGED=false
# Set true in staging/production. Paid-tier Gemini or Vertex AI only; free-tier may train on resumes.

STORAGE_BACKEND=local
# local keeps PDFs on STORAGE_DIR. s3 uses a private bucket.
STORAGE_DIR=var/resumes
S3_BUCKET=top-match
S3_REGION=ap-south-1
S3_PREFIX=
S3_UPLOAD_URL_SECONDS=600
# Optional. If empty, aioboto3 uses ~/.aws/credentials or the instance role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MAX_UPLOAD_BYTES=5242880
MAX_RESUME_PAGES=5
OCR_DPI=150
OCR_MAX_PAGE_PIXELS=4000000
